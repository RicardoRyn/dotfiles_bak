[init]
  defaultBranch = main
[commit]
  gpgsign = true
[merge]
  conflictStyle = zdiff3

[delta]
  navigate = true  # use n and N to move between diff sections
  line-numbers = true
  features = catppuccin-latte
[core]
  pager = delta
  autocrlf = input
[interactive]
  diffFilter = delta --color-only
[include]
  path = C:/Users/RicardoRyn/dotfiles/catppuccin.gitconfig
